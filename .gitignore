# Private / local overlays. Root-anchored: these are top-level directories, and
# an unanchored pattern would also swallow any nested dir of the same name.
/accounts/
/regions/
/local/
my-values*.yaml
/secrets.yaml

# Secrets and registry credentials
*.key
*.pem
key.json
gcr-keys.json
gha-creds-*.json

# Helm packages and build output. *.tgz covers charts/*.tgz too.
*.tgz
*.tar.gz
.helm/
test-results/
rendered-charts/

# Editor, OS and backup noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
*.bak
*.backup
*.log

# CI scratch
commits.txt
request.json
