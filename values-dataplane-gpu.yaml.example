# Hybrid with GPU Firewall workers.
# Layer over a TrustGuard-enabled base (values-required.yaml or
# values-trustguard.yaml.example) and replace the registry and scheduling
# labels. Firewall follows TrustGuard automatically.

firewall:
  firewall:
    gateway:
      image:
        repository: "<registry>/firewall-cpu"
    workerDefaults:
      image:
        repository: "<registry>/firewall-gpu"
      resources:
        requests:
          cpu: "1"
          memory: 4Gi
          nvidia.com/gpu: "1"
        limits:
          cpu: "2"
          memory: 8Gi
          nvidia.com/gpu: "1"
      nodeSelector:
        accelerator: "nvidia"
      tolerations:
        - key: "nvidia.com/gpu"
          operator: "Exists"
          effect: "NoSchedule"
      hostIPC: true
    # These two carry their own `resources` in the chart defaults, and a
    # per-worker `resources` replaces workerDefaults.resources rather than
    # merging with it, so the GPU request is restated for them.
    workers:
      prompt-moderation:
        resources:
          requests:
            nvidia.com/gpu: "1"
          limits:
            memory: 8Gi
            nvidia.com/gpu: "1"
      topic-guard:
        resources:
          requests:
            memory: 4Gi
            nvidia.com/gpu: "1"
          limits:
            memory: 8Gi
            nvidia.com/gpu: "1"
    config:
      cudaMpsActiveThreadPercentage: "25"
      cudaMpsPinnedDeviceMemLimit: "6000M"
