# Hybrid with GPU Firewall workers.
# Layer over a TrustGuard-enabled base (values-required.yaml or
# values-trustguard.yaml.example) and replace the registry and scheduling
# labels. Firewall follows TrustGuard automatically.

firewall:
  firewall:
    gateway:
      image:
        repository: "<registry>/firewall-cpu"
    workerDefaults:
      image:
        repository: "<registry>/firewall-gpu"
      resources:
        requests:
          cpu: "1"
          memory: 4Gi
          nvidia.com/gpu: "1"
        limits:
          cpu: "2"
          memory: 8Gi
          nvidia.com/gpu: "1"
      nodeSelector:
        accelerator: "nvidia"
      tolerations:
        - key: "nvidia.com/gpu"
          operator: "Exists"
          effect: "NoSchedule"
      hostIPC: true
    # A worker's own `resources` merges over workerDefaults.resources, so every
    # worker inherits the GPU request. These two carry larger memory in the chart
    # defaults; raise it further for the GPU image.
    workers:
      # prompt-jailbreak defaults to RollingUpdate. One GPU cannot surge
      # (maxUnavailable: 0 waits for a second device), so keep Recreate.
      prompt-jailbreak:
        deploymentStrategy: Recreate
      prompt-moderation:
        resources:
          limits:
            memory: 8Gi
      topic-guard:
        resources:
          requests:
            memory: 4Gi
          limits:
            memory: 8Gi
    config:
      cudaMpsActiveThreadPercentage: "25"
      cudaMpsPinnedDeviceMemLimit: "6000M"
