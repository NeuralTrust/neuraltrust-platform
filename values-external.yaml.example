# External: self-hosted control/data planes and analytics.
# ClickStack OTel Collector, DataCore, and AlertEngine render only in this mode.
# DataAgent never renders here. Every product deploys unless global.products
# turns it off — see values-external-trustguard-only.yaml.example.
#
# Before install, create gcr-secret, the trustguard-firewall Secret (key
# FIREWALL_JWT, the firewall key NeuralTrust sends you for this install) and
# (recommended) a bootstrap admin Secret named onprem-superadmin. To run the
# firewall in this cluster instead, set global.firewall.deploy: true and drop
# trustguard.firewall. Walkthrough: README-EXTERNAL.md.

global:
  deploymentMode: "external"
  # Prefer a pre-created Secret (keys default to ONPREM_SUPERADMIN_EMAIL /
  # ONPREM_SUPERADMIN_PASSWORD). Inline email+password still works but enters
  # Helm release history.
  superadmin:
    existingSecret:
      name: "onprem-superadmin"
  platform: "kubernetes"
  domain: "platform.example.com"
  observability:
    hostedExport:
      enabled: false

# TrustGuard calls the NeuralTrust-hosted firewall with the key NeuralTrust
# issues for this install.
trustguard:
  firewall:
    jwtExistingSecret:
      name: "trustguard-firewall"
