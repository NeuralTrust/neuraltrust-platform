# Hybrid overlay for a fully-configured deployment.
# Documents the "one Postgres block, one Redis block, per-product DataAgent"
# hybrid contract using pre-created Secrets. Prefer existingSecret for
# DataAgent enrolment (also powers ClickStack egress) and config-sync.
# Product OTLP and config-sync are on by default in hybrid.
#
# Positive product slices (mix with -f; no all-off baseline):
#   values-trustgate.yaml.example
#   values-trustguard.yaml.example
#   values-red-teaming.yaml.example
# External mode ignores global.products and always deploys the full stack.
#
# Never commit real tokens, passwords, or customer identifiers.
# For the minimal starting point, see values-required.yaml.

global:
  deploymentMode: "hybrid"
  platform: "kubernetes" # aws | gcp | azure | openshift | kubernetes
  domain: "platform.example.com"
  products:
    trustgate: true
    trustguard: true
    dataPlane: true

  # One shared PostgreSQL block. Every hybrid workload (TrustGate,
  # TrustGuard, DataAgent, data-plane-api) reads envFrom the rendered
  # postgresql-secrets Secret, so all four connect as the same role to the
  # same database.
  #
  # In-cluster (default): leave deploy: true and host/password empty — the
  # chart renders control-plane-postgresql with user/database = neuraltrust
  # and a generated password.
  #
  # External / managed: set deploy: false and reference your own Secret.
  # Naming it here stops the chart rendering postgresql-secrets, so nothing
  # renames your keys — TrustGate, TrustGuard and DataAgent take the Secret
  # with envFrom and read these names verbatim:
  #
  #   kubectl create secret generic external-postgresql -n neuraltrust \
  #     --from-literal=DB_HOST='pg.example.com' \
  #     --from-literal=DB_PORT='5432' \
  #     --from-literal=DB_USER='neuraltrust' \
  #     --from-literal=DB_PASSWORD='<password>' \
  #     --from-literal=DB_NAME='neuraltrust' \
  #     --from-literal=DB_SSL_MODE='require' \
  #     --from-literal=POSTGRES_LOGIN='default' \
  #     --from-literal=SENSIBLE_PG_DSN='postgresql://neuraltrust:<password>@pg.example.com:5432/neuraltrust?sslmode=require'
  #
  # DB_SSL_MODE matters: omit it and the gateways fall back to their built-in
  # "disable", silently turning a TLS install into a plaintext one.
  # SENSIBLE_PG_DSN is what DataAgent reads as DATABASE_URL. POSTGRES_LOGIN is
  # the IAM switch — "default" for password auth, "aws" for IAM.
  #
  # Pre-create the role and database out-of-band; the chart never runs
  # CREATE USER, and there is no migration Job for the shared database.
  postgresql:
    deploy: false
    existingSecret:
      name: "external-postgresql"

  # One shared Redis block. In-cluster default is passwordless on Service
  # `redis:6379`. For a hosted / TLS-only Redis set deploy: false and
  # reference a Secret with REDIS_HOST, REDIS_PORT, REDIS_PASSWORD, and
  # optional REDIS_USERNAME / REDIS_TLS.
  redis:
    deploy: false
    existingSecret:
      name: "external-redis"

# TrustGate (commercial name; image/repo still agentgateway; K8s names
# agentgateway-*). Nested dataagent so product overlays mix via -f.
agentgateway:
  configSync:
    existingSecret:
      name: "agentgateway-config-sync"
  dataagent:
    enrolment:
      existingSecret:
        name: "dataagent-enrolment-trustgate"

trustguard:
  configSync:
    existingSecret:
      name: "trustguard-config-sync"
  dataagent:
    enrolment:
      existingSecret:
        name: "dataagent-enrolment-trustguard"

# The temporary data-plane-api read shim. In hybrid it defaults to PostgreSQL
# (SQL_DATABASE=postgres).
#
# It does NOT follow global.postgresql.existingSecret — it has its own
# reference, defaulting to the chart's postgresql-secrets. Since naming an
# existingSecret above stops that Secret being rendered, leaving this out
# points data-plane-api at a Secret that does not exist and its pods stay in
# CreateContainerConfigError. Repeat the Secret here and map your DB_* keys
# onto the names this component looks up.
#
# Omit this whole block when global.postgresql has no existingSecret — the
# chart renders postgresql-secrets and the defaults resolve.
data-plane-api:
  dataPlane:
    components:
      api:
        database:
          postgresql:
            existingSecret:
              name: "external-postgresql"
              keys:
                host: "DB_HOST"
                port: "DB_PORT"
                user: "DB_USER"
                password: "DB_PASSWORD"
                database: "DB_NAME"
