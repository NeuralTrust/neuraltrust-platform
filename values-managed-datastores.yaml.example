# External with every datastore managed outside the cluster: PostgreSQL, Redis
# and ClickHouse.
#
# Managed PostgreSQL and Redis are the usual production choice. Managed
# ClickHouse is not — most external deployments let the chart run ClickHouse
# in-cluster, since it is the platform's own telemetry store. This file shows
# the fully external case because it is the one with the most moving parts.
#
# To keep ClickHouse in-cluster, drop the `infrastructure.clickhouse` block
# below and the four `clickhouse:` overlays that reference `managed-clickhouse`.
# Because this file also sets preserveExistingSecrets=true, swap the
# `managed-clickhouse` entry in the pre-create list for the Secrets the
# in-cluster StatefulSet expects instead:
# - clickhouse-secrets: admin-password, CLICKHOUSE_HOST, CLICKHOUSE_PORT,
#   CLICKHOUSE_DATABASE
# - clickhouse: CLICKHOUSE_USER
#
# Pre-create the service databases/roles and Kubernetes Secrets before install.
# This file contains endpoints and secret names only; it contains no credentials.
#
# PostgreSQL and Redis endpoints are declared ONCE, on global.postgresql and
# global.redis. Since chart 2.6.0 every service inherits host/port/sslMode and
# host/port/username/tls from those blocks, so a per-service `database:` or
# `redis:` block is only needed to send one service somewhere else. What stays
# per-service is identity, not endpoint: external mode gives each service its own
# role and database (`agentgateway`, `trustguard`, `alertengine`, `datacore`),
# and `database.name` / `database.user` default to the service name.
#
# With preserveExistingSecrets=true, pre-create at least:
# - control-plane-secrets: AUTH_SECRET, NEXTAUTH_SECRET, CONTROL_PLANE_JWT_SECRET
# - postgresql-secrets: POSTGRES_HOST, POSTGRES_PORT, POSTGRES_USER, POSTGRES_DB,
#   POSTGRES_SSLMODE, POSTGRES_LOGIN, POSTGRES_AUTH_MODE, POSTGRES_CONNECTION_TYPE,
#   SENSIBLE_PG_DSN, POSTGRES_PRISMA_URL
#   (and POSTGRES_PASSWORD in password mode)
#   Do NOT add DB_* or DATABASE_URL here — the chart maps the keys above to
#   whatever variable names each container expects. This applies to the chart's
#   own `postgresql-secrets`, as used here. The opposite holds if you instead
#   point `global.postgresql.existingSecret.name` at a Secret of your own: the
#   chart then renders no Secret to map from, every consumer envFrom's yours
#   directly, and its keys must be DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME/
#   DB_SSL_MODE plus SENSIBLE_PG_DSN. See SECRETS.md.
# - agentgateway-secrets: SERVER_SECRET_KEY, STS_SIGNING_KEY, DB_PASSWORD
# - trustguard-secrets: ADMIN_JWT_SECRET, TRUSTGUARD_TOKEN_SIGNING_SECRET,
#   REDIS_EVENTS_SECRET, DB_PASSWORD
# - trustguard-client-credentials: CLIENT_ID, CLIENT_SECRET
# - data-plane-jwt-secret: DATA_PLANE_JWT_SECRET, REDIS_URL
# - datacore-secrets: AUTH_JWT_HS256_SECRET, CLICKHOUSE_USER
#   (and POSTGRES_PASSWORD in password mode; omit when datacore.database.iamAuth=true)
# - alertengine-secrets: DB_PASSWORD, AUTH_JWT_SECRET, APP_ENCRYPTION_KEY
# - clickstack-collector-secrets: CLICKHOUSE_ENDPOINT, CLICKHOUSE_USER,
#   OTLP_AUTH_TOKEN
# - managed-clickhouse: password (the shared ClickHouse credential referenced below)
# Omit static DB password keys only for services whose IAM mode is supported.
# See SECRETS.md for the complete per-component contract.

global:
  deploymentMode: "external"
  # Optional bootstrap admin — prefer existingSecret over inline password:
  # superadmin:
  #   existingSecret:
  #     name: "onprem-superadmin"

  platform: "kubernetes"
  domain: "platform.example.com"
  autoGenerateSecrets: false
  preserveExistingSecrets: true
  # One PostgreSQL endpoint for the whole platform. `deploy: false` skips the
  # in-cluster Deployment; host/port/sslMode are what every service inherits.
  postgresql:
    deploy: false
    host: "postgres.example.com"
    port: "5432"
    sslMode: "require"
  # One Redis endpoint for the whole platform, same inheritance.
  redis:
    deploy: false
    host: "redis.example.com"
    tls: "true"
  observability:
    hostedExport:
      enabled: false

infrastructure:
  clickhouse:
    deploy: false
    external:
      host: "clickhouse.example.com"
      port: "8443"
      user: "neuraltrust"
      database: "neuraltrust"
      secretName: "managed-clickhouse"
      secretKey: "password"

# AgentGateway and TrustGuard need no block at all now: they inherit both
# endpoints from the global blocks above, and their databases/roles default to
# their own names. ClickHouse has no global block, so it is named per consumer.
alertengine:
  enabled: true
  clickhouse:
    host: "clickhouse.example.com"
    nativePort: 9440
    secure: true
    existingSecret:
      name: "managed-clickhouse"
      key: "password"

datacore:
  clickhouse:
    host: "clickhouse.example.com"
    nativePort: 9440
    tls: true
    existingSecret:
      name: "managed-clickhouse"
      key: "password"

clickstack-otel-collector:
  clickhouse:
    endpoint: "https://clickhouse.example.com:8443"
    existingSecret:
      name: "managed-clickhouse"
      key: "password"

data-plane-api:
  dataPlane:
    components:
      clickhouse:
        host: "clickhouse.example.com"
        port: "8443"
        existingSecret:
          name: "managed-clickhouse"
          key: "password"

# Control-plane split (external only). Both charts read POSTGRES_* from the
# pre-created postgresql-secrets listed at the top of this file — with
# autoGenerateSecrets=false the chart renders no Secret at all, so the managed
# host/port/DSNs must be in the Secret you create. The per-chart
# `controlPlane.components.postgresql.secrets.host` overlay only feeds the
# chart-generated Secret, so it is not needed here.
