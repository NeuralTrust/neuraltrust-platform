# External with every datastore managed outside the cluster: PostgreSQL, Redis
# and ClickHouse.
#
# Managed PostgreSQL and Redis are the usual production choice. Managed
# ClickHouse is not — most external deployments let the chart run ClickHouse
# in-cluster, since it is the platform's own telemetry store. This file shows
# the fully external case because it is the one with the most moving parts.
#
# To keep ClickHouse in-cluster, drop the `infrastructure.clickhouse` block
# below and the four `clickhouse:` overlays that reference `managed-clickhouse`.
# Because this file also sets preserveExistingSecrets=true, swap the
# `managed-clickhouse` entry in the pre-create list for the Secrets the
# in-cluster StatefulSet expects instead:
# - clickhouse-secrets: admin-password, CLICKHOUSE_HOST, CLICKHOUSE_PORT,
#   CLICKHOUSE_DATABASE
# - clickhouse: CLICKHOUSE_USER
#
# Pre-create the service databases/roles and Kubernetes Secrets before install.
# This file contains endpoints and secret names only; it contains no credentials.
#
# PostgreSQL and Redis endpoints are declared ONCE, on global.postgresql and
# global.redis. Since chart 2.6.0 every service inherits host/port/sslMode and
# host/port/username/tls from those blocks, so a per-service `database:` or
# `redis:` block is only needed to send one service somewhere else. What stays
# per-service is identity, not endpoint: external mode gives each service its own
# role and database (`agentgateway`, `trustguard`, `alertengine`, `datacore`),
# and `database.name` / `database.user` default to the service name.
#
# With preserveExistingSecrets=true, pre-create at least:
# - control-plane-secrets: AUTH_SECRET, NEXTAUTH_SECRET, CONTROL_PLANE_JWT_SECRET
# - postgresql-secrets: POSTGRES_HOST, POSTGRES_PORT, POSTGRES_USER, POSTGRES_DB,
#   POSTGRES_SSLMODE, POSTGRES_LOGIN, POSTGRES_AUTH_MODE, POSTGRES_CONNECTION_TYPE
#   (and POSTGRES_PASSWORD in password mode, unless
#    global.postgresql.passwordSecret points elsewhere)
#   POSTGRES_PRISMA_URL is optional: control-plane-app builds its own connection
#   from the parts above when the key is absent. SENSIBLE_PG_DSN is hybrid-only —
#   nothing in external reads it.
#   Do NOT add DB_* or DATABASE_URL here — the chart maps the keys above to
#   whatever variable names each container expects. This applies to the chart's
#   own `postgresql-secrets`, as used here. The opposite holds if you instead
#   point `global.postgresql.existingSecret.name` at a Secret of your own: the
#   chart then renders no Secret to map from, every consumer envFrom's yours
#   directly, and its keys must be DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME/
#   DB_SSL_MODE (plus SENSIBLE_PG_DSN in hybrid). See SECRETS.md.
# - agentgateway-secrets: SERVER_SECRET_KEY, STS_SIGNING_KEY
# - trustguard-secrets: ADMIN_JWT_SECRET, TRUSTGUARD_TOKEN_SIGNING_SECRET,
#   REDIS_EVENTS_SECRET
# - trustguard-client-credentials: CLIENT_ID, CLIENT_SECRET
# - data-plane-jwt-secret: DATA_PLANE_JWT_SECRET
# - datacore-secrets: AUTH_JWT_HS256_SECRET, CLICKHOUSE_USER
# - alertengine-secrets: AUTH_JWT_SECRET, APP_ENCRYPTION_KEY
# The datastore passwords are deliberately absent from those four: the
# `existingSecret` blocks at the bottom of this file move them into two Secrets of
# their own, so rotating a database password never touches a Secret holding
# signing keys. Keep them inline in the lists above instead if you prefer one
# Secret per service.
# - clickstack-collector-secrets: CLICKHOUSE_ENDPOINT, CLICKHOUSE_USER,
#   OTLP_AUTH_TOKEN
# - clickhouse-secrets: CLICKHOUSE_HOST, CLICKHOUSE_PORT, CLICKHOUSE_USER,
#   CLICKHOUSE_DATABASE (read by data-plane-api and its migration initContainer)
#   With autoGenerateSecrets=false the chart writes none of these, so the values in
#   the two Secrets above must match `global.clickhouse` below. The chart still
#   templates the parts that are not Secret data -- the CLICKHOUSE_PASSWORD
#   secretKeyRef, the wait-for-ClickHouse initContainers and the migration job's
#   native port -- and those all resolve from `global.clickhouse`, so a mismatch
#   shows up as a connection failure rather than a render error.
# - managed-clickhouse: password (the shared ClickHouse credential referenced below)
# - managed-postgres-roles: CONTROL_PLANE, AGENTGATEWAY, TRUSTGUARD, ALERTENGINE,
#   DATACORE
# - managed-redis-auth: REDIS_PASSWORD, REDIS_URL
#   (REDIS_URL is the whole DSN, e.g. rediss://user:pw@redis.example.com:6379/0 —
#    data-plane-api reads an assembled URL rather than a password)
# Omit static DB password keys only for services whose IAM mode is supported.
# See SECRETS.md for the complete per-component contract.

global:
  deploymentMode: "external"
  # Optional bootstrap admin — prefer existingSecret over inline password:
  # superadmin:
  #   existingSecret:
  #     name: "onprem-superadmin"

  platform: "kubernetes"
  domain: "platform.example.com"
  autoGenerateSecrets: false
  preserveExistingSecrets: true
  # One PostgreSQL endpoint for the whole platform. `deploy: false` skips the
  # in-cluster Deployment; host/port/sslMode are what every service inherits.
  postgresql:
    deploy: false
    host: "postgres.example.com"
    port: "5432"
    sslMode: "require"
    # The control-plane role's password, in the same Secret as the four service
    # roles below. External composes no connection string, so it never has to be
    # readable while Helm renders. Needs an app image carrying
    # scripts/postgres-password-url.mjs for the migration step.
    #
    # Safe alongside preserveExistingSecrets above: the chart drops the
    # connection-string env entries in this mode, so a POSTGRES_PRISMA_URL left
    # in the Secret you pre-created is never read and cannot keep an old
    # password alive.
    passwordSecret:
      name: "managed-postgres-roles"
      key: "CONTROL_PLANE"
  # One Redis endpoint for the whole platform, same inheritance.
  redis:
    deploy: false
    host: "redis.example.com"
    tls: "true"
  observability:
    hostedExport:
      enabled: false
  # ClickHouse, named once for every consumer (AUT-636). Two ports because the
  # consumers split by protocol: DataCore, AlertEngine and watchdog speak the
  # native protocol, data-plane-api and the ClickStack collector use HTTP.
  #
  # This replaces `infrastructure.clickhouse.external`, which was inert -- a
  # subchart cannot read `.Values.infrastructure`, so three of the five consumers
  # ignored it. That is why this file used to restate the endpoint four more times
  # below; it no longer needs to.
  clickhouse:
    host: "clickhouse.example.com"
    httpPort: "8443"
    nativePort: "9440"
    user: "neuraltrust"
    tls: true
    existingSecret:
      name: "managed-clickhouse"
      key: "password"

infrastructure:
  clickhouse:
    # Stops the in-cluster ClickHouse rendering. `global.clickhouse` above says
    # where the real one is -- both are needed.
    deploy: false

# Datastore passwords, read from two Secrets instead of written here. `key` is
# configurable, so one Secret holds every database role under its own key. Only
# identity and endpoints live in this file; no credential does.
agentgateway:
  database:
    existingSecret:
      name: "managed-postgres-roles"
      key: "AGENTGATEWAY"
  redis:
    existingSecret:
      name: "managed-redis-auth" # key defaults to REDIS_PASSWORD

trustguard:
  database:
    existingSecret:
      name: "managed-postgres-roles"
      key: "TRUSTGUARD"
  redis:
    existingSecret:
      name: "managed-redis-auth"

# ClickHouse is no longer restated per consumer -- `global.clickhouse` above covers
# all five. A per-service `clickhouse:` block still overrides it for that service
# alone, which is the only reason to add one back.
alertengine:
  enabled: true
  database:
    existingSecret:
      name: "managed-postgres-roles"
      key: "ALERTENGINE"

datacore:
  database:
    existingSecret:
      name: "managed-postgres-roles"
      key: "DATACORE"

data-plane-api:
  dataPlane:
    components:
      api:
        redis:
          existingSecret:
            name: "managed-redis-auth"
            key: "REDIS_URL"

# Control-plane split (external only). Both charts read POSTGRES_* from the
# pre-created postgresql-secrets listed at the top of this file — with
# autoGenerateSecrets=false the chart renders no Secret at all, so the managed
# host/port/DSNs must be in the Secret you create. The per-chart
# `controlPlane.components.postgresql.secrets.host` overlay only feeds the
# chart-generated Secret, so it is not needed here.
