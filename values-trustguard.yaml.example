# Positive TrustGuard hybrid slice (TrustGuard + its DataAgent).
# TrustGuard calls the NeuralTrust-hosted firewall with the FIREWALL_JWT the
# console showed when it created this TrustGuard (Secret key FIREWALL_JWT).
# To run the firewall in this cluster, or use one you already run, see the
# global.firewall block below.
# Use a distinct DataAgent enrolment Secret from the TrustGate slice.
#
#   helm upgrade --install neuraltrust-platform <chart> \
#     --namespace neuraltrust --create-namespace \
#     -f <environment-values.yaml> \
#     -f values-trustguard.yaml.example

global:
  products:
    trustguard: true
  # firewall:
  #   # In this cluster (drop trustguard.firewall below):
  #   deploy: true
  #   # Or a firewall you already run:
  #   deploy: false
  #   baseURL: "http://firewall.<namespace>.svc.cluster.local"
  #   existingSecret:
  #     name: "<secret holding that firewall's JWT_SECRET>"
  #     key: "JWT_SECRET"

trustguard:
  configSync:
    existingSecret:
      name: "trustguard-config-sync"
  dataagent:
    enrolment:
      existingSecret:
        name: "dataagent-enrolment-trustguard"
  firewall:
    jwtExistingSecret:
      name: "trustguard-firewall"
