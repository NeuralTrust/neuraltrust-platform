# Positive TrustGuard hybrid slice (TrustGuard + Firewall + its DataAgent).
# Firewall follows TrustGuard; to use one you already run instead, uncomment the
# global.firewall block below.
# Use a distinct DataAgent enrolment Secret from the TrustGate slice.
#
#   helm upgrade --install neuraltrust-platform <chart> \
#     --namespace neuraltrust --create-namespace \
#     -f <environment-values.yaml> \
#     -f values-trustguard.yaml.example

global:
  products:
    trustguard: true
  # firewall:
  #   deploy: false
  #   baseURL: "http://firewall.<namespace>.svc.cluster.local"
  #   existingSecret:
  #     name: "<secret holding the external firewall JWT_SECRET>"
  #     key: "JWT_SECRET"

trustguard:
  configSync:
    existingSecret:
      name: "trustguard-config-sync"
  dataagent:
    enrolment:
      existingSecret:
        name: "dataagent-enrolment-trustguard"
